# Private control file. Fill actual values in the intranet; chmod 600.
# Parser accepts KEY=value or KEY='literal value', no interpolation or multiline values.
ENVIRONMENT=production
COMPOSE_PROJECT_NAME=lighthouse-production
DATA_ROOT=/data/lighthouse-production
BACKUP_ROOT=/data/lighthouse-backups/production
APP_ENV_FILE=/data/lighthouse-config/production-app.env
LIGHTHOUSE_IMAGE=registry.example/lighthouse@sha256:REPLACE_WITH_MASTER_BUILD_DIGEST
LIGHTHOUSE_TOOLS_IMAGE=registry.example/lighthouse-operations@sha256:REPLACE_WITH_MASTER_BUILD_DIGEST
MYSQL_IMAGE=registry.example/mysql@sha256:REPLACE_WITH_MYSQL_DIGEST
MYSQL_DATABASE=lighthouse_production
MYSQL_USER=lighthouse_production
MYSQL_PASSWORD='REPLACE_WITH_DISTINCT_APPLICATION_PASSWORD'
MYSQL_ROOT_PASSWORD='REPLACE_WITH_DISTINCT_ROOT_PASSWORD'
# Percent-encode URL username/password; root password must never appear here.
DATABASE_URL='mysql://lighthouse_production:REPLACE_WITH_URL_ENCODED_PASSWORD@mysql:3306/lighthouse_production'
HTTP_BIND=127.0.0.1
HTTP_PORT=18080
APP_UID=1000
APP_GID=1000
APP_MEMORY=1536m
MYSQL_MEMORY=1g
OPERATIONS_MEMORY=1g
GATEWAY_ENABLED=true
GATEWAY_NETWORK=REPLACE_WITH_EXISTING_GATEWAY_NETWORK
GATEWAY_ALIAS=lighthouse-production-app
