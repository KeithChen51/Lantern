# Private application-only runtime config. Never put MYSQL_ROOT_PASSWORD here.
# Supply model and authentication secrets only inside the intranet; chmod 600.
HERMIT_RUNTIME=dsh
HERMIT_DSH_ROOT=
HERMIT_BUNDLE_REQUIRED=true
OPENAI_BASE_URL=REPLACE_WITH_INTERNAL_MODEL_ENDPOINT
OPENAI_MODEL=REPLACE_WITH_INTERNAL_MODEL_NAME
OPENAI_API_MODE=chat
OPENAI_API_KEY='REPLACE_WITH_PRIVATE_MODEL_KEY'
AUTH_MODE=portal
LIGHTHOUSE_ORIGIN=https://formal.example
AUTH_TEST_HTTP_ORIGIN=
AUTH_ALLOW_LOCAL_HTTP=false
PORTAL_API_BASE_URL=https://portal.example/api
# Only if the verified server API uses HTTP: exact RFC1918 IPv4 origin,
# e.g. http://10.20.30.40:20002, matching PORTAL_API_BASE_URL.origin.
PORTAL_API_HTTP_ORIGIN=
PORTAL_LOGIN_URL=https://portal.example/login
PORTAL_LOGIN_MODE=card
# Production/test may share the confirmed portal appKey/roles.
PORTAL_APP_CODE=REPLACE_WITH_CONFIRMED_PORTAL_APPLICATION
PORTAL_APP_SECRET='REPLACE_WITH_PRIVATE_PORTAL_SECRET'
PORTAL_KNOWLEDGE_ADMIN_ROLE=REPLACE_WITH_EXACT_ROLE
# Optional: only the portal-confirmed exact platform-admin role identifier.
PORTAL_PLATFORM_ADMIN_ROLE=
AUTH_ENCRYPTION_KEY='REPLACE_WITH_PRIVATE_BASE64_32_BYTE_KEY'
# Set true only after the portal confirms active internal employee semantics.
PORTAL_EMPLOYEE_VALIDATION_CONFIRMED=false
PORTAL_CALLBACK_PARAM=redirectUrl
PORTAL_STATE_PARAM=state
PORTAL_TOKEN_PARAM=token
PORTAL_ALLOW_LEGACY_CONFIRMATION=false
# Keys remain stable across upgrades and are saved in protected recovery material.
# For HTTP test use test-app.env.example. Browser portal login remains HTTPS.
