# Private application-only runtime config. Never put MYSQL_ROOT_PASSWORD here.
# Supply model and authentication secrets only inside the intranet; chmod 600.
HERMIT_RUNTIME=dsh
HERMIT_DSH_ROOT=
HERMIT_BUNDLE_REQUIRED=true
OPENAI_BASE_URL=REPLACE_WITH_INTERNAL_MODEL_ENDPOINT
OPENAI_MODEL=REPLACE_WITH_INTERNAL_MODEL_NAME
OPENAI_API_MODE=chat
OPENAI_API_KEY='REPLACE_WITH_PRIVATE_MODEL_KEY'
# New deployment template only. Do not overwrite a running portal environment.
# IAM employee template. For explicit visitor access use guest-app.env.example.
NODE_ENV=production
LIGHTHOUSE_DEPLOYMENT_ENV=production
AUTH_MODE=iam
IAM_AUTHORIZATION_SOURCE=sync
LIGHTHOUSE_ORIGIN=https://formal.example
AUTH_TEST_HTTP_ORIGIN=
AUTH_ALLOW_LOCAL_HTTP=false
IAM_BASE_URL=https://sso.byd.com
IAM_CLIENT_ID=REPLACE_WITH_REGISTERED_IAM_CLIENT_ID
IAM_CLIENT_SECRET='REPLACE_WITH_PRIVATE_IAM_CLIENT_SECRET'
IAM_SYNC_APP_KEY=REPLACE_WITH_REGISTERED_SYNC_APP_KEY
IAM_SYNC_PUBLIC_KEY='REPLACE_WITH_BASE64_SPKI_RSA_PUBLIC_KEY'
IAM_SYNC_AES_KEY='REPLACE_WITH_PRIVATE_BASE64_32_BYTE_AES_KEY'
IAM_SYNC_AES_IV='REPLACE_WITH_PRIVATE_BASE64_16_BYTE_IV'
AUTH_ENCRYPTION_KEY='REPLACE_WITH_PRIVATE_BASE64_32_BYTE_LOCAL_KEY'
# These are separate keys. Preserve the existing AUTH_ENCRYPTION_KEY on upgrade.
# Register /auth/iam/callback plus inbound account/permission sync and catalogue URLs.
# Accounts and allowed roles must be synchronized before employee login can succeed.
# See docs/deployment/lighthouse-iam-direct.md for staged cutover and recovery.
# For IAM login + middle-platform roles use iam-portal-app.env.example instead.
