# Private application-only production guest runtime config; chmod 600.
# No IAM_* or PORTAL_* credentials and no MYSQL_ROOT_PASSWORD belong here.
# Use the same app image digest as IAM test, with distinct DB/mount/origin/key.
NODE_ENV=production
LIGHTHOUSE_DEPLOYMENT_ENV=production
AUTH_MODE=guest
LIGHTHOUSE_ORIGIN=https://lighthouse.example.invalid
AUTH_TEST_HTTP_ORIGIN=
AUTH_ALLOW_LOCAL_HTTP=false
# Stable, randomly generated Base64 32-byte key. Preserve this environment's
# existing AUTH_ENCRYPTION_KEY across upgrades/mode changes. Never copy test keys.
AUTH_ENCRYPTION_KEY='REPLACE_WITH_DISTINCT_PRODUCTION_BASE64_32_BYTE_LOCAL_KEY'
# Compose injects DATABASE_URL, KNOWLEDGE_HUB_ENABLED=true and
# KNOWLEDGE_HUB_DRIVER=mysql from the private production control file.
HERMIT_RUNTIME=dsh
HERMIT_DSH_ROOT=
HERMIT_BUNDLE_REQUIRED=true
OPENAI_BASE_URL=REPLACE_WITH_INTERNAL_MODEL_ENDPOINT
OPENAI_MODEL=REPLACE_WITH_INTERNAL_MODEL_NAME
OPENAI_API_MODE=chat
OPENAI_API_KEY='REPLACE_WITH_PRIVATE_MODEL_KEY'
