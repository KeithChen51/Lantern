# For a NEW isolated test stack only. Do not point this at existing test data or volumes.
ENVIRONMENT=test
COMPOSE_PROJECT_NAME=lighthouse-test-isolated
DATA_ROOT=/data/lighthouse-test-isolated
BACKUP_ROOT=/data/lighthouse-backups/test-isolated
APP_ENV_FILE=/data/lighthouse-config/test-app.env
# For a same-artifact guest/IAM comparison, use the exact same app/tools digest
# pair as production.env (each repository has its own digest). See guest-mode guide.
LIGHTHOUSE_IMAGE=registry.example/lighthouse@sha256:REPLACE_WITH_VERIFIED_APP_DIGEST
LIGHTHOUSE_TOOLS_IMAGE=registry.example/lighthouse-tools@sha256:REPLACE_WITH_MATCHING_TOOLS_DIGEST
MYSQL_IMAGE=registry.example/mysql@sha256:REPLACE_WITH_MYSQL_DIGEST
MYSQL_DATABASE=lighthouse_test
MYSQL_USER=lighthouse_test
MYSQL_PASSWORD='REPLACE_WITH_DISTINCT_APPLICATION_PASSWORD'
MYSQL_ROOT_PASSWORD='REPLACE_WITH_DISTINCT_ROOT_PASSWORD'
DATABASE_URL='mysql://lighthouse_test:REPLACE_WITH_URL_ENCODED_PASSWORD@mysql:3306/lighthouse_test'
HTTP_BIND=0.0.0.0
# This NEW isolated stack uses a different free port from the existing 16888 stack.
# In its private APP_ENV_FILE set LIGHTHOUSE_ORIGIN/AUTH_TEST_HTTP_ORIGIN to the
# actual isolated origin with this port; never copy the existing stack's origin.
HTTP_PORT=18081
APP_UID=1000
APP_GID=1000
APP_MEMORY=1536m
MYSQL_MEMORY=1g
OPERATIONS_MEMORY=1g
GATEWAY_ENABLED=false
