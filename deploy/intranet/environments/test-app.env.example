# Private runtime file for the existing HTTP IP test endpoint.
# Synthetic RFC1918 example only. Retain the actual existing IP/port privately;
# IAM must approve that exact HTTP callback before employee acceptance.
# LIGHTHOUSE_DEPLOYMENT_ENV=test is supplied by the new compose. In existing
# compose, explicitly set it here as well.
NODE_ENV=production
LIGHTHOUSE_DEPLOYMENT_ENV=test
# Explicit IAM cutover only after credentials, network and initial sync are ready.
AUTH_MODE=iam
LIGHTHOUSE_ORIGIN=http://10.20.30.40:18081
AUTH_TEST_HTTP_ORIGIN=http://10.20.30.40:18081
AUTH_ALLOW_LOCAL_HTTP=false
# IAM server calls always use HTTPS, even when the browser test entry is HTTP.
IAM_BASE_URL=https://sso.byd.com
IAM_CLIENT_ID=REPLACE_WITH_REGISTERED_IAM_CLIENT_ID
IAM_CLIENT_SECRET='REPLACE_WITH_PRIVATE_IAM_CLIENT_SECRET'
IAM_SYNC_APP_KEY=REPLACE_WITH_REGISTERED_SYNC_APP_KEY
IAM_SYNC_PUBLIC_KEY='REPLACE_WITH_BASE64_SPKI_RSA_PUBLIC_KEY'
IAM_SYNC_AES_KEY='REPLACE_WITH_PRIVATE_BASE64_32_BYTE_AES_KEY'
IAM_SYNC_AES_IV='REPLACE_WITH_PRIVATE_BASE64_16_BYTE_IV'
AUTH_ENCRYPTION_KEY='REPLACE_WITH_DISTINCT_TEST_BASE64_32_BYTE_LOCAL_KEY'
# Keep this environment's existing AUTH_ENCRYPTION_KEY on upgrade. IAM keys differ
# from middle-platform secrets; do not copy keys between test and production.
HERMIT_RUNTIME=dsh
HERMIT_DSH_ROOT=
HERMIT_BUNDLE_REQUIRED=true
OPENAI_BASE_URL=REPLACE_WITH_INTERNAL_MODEL_ENDPOINT
OPENAI_MODEL=REPLACE_WITH_INTERNAL_MODEL_NAME
OPENAI_API_MODE=chat
OPENAI_API_KEY='REPLACE_WITH_PRIVATE_MODEL_KEY'
