# Private runtime file for the existing HTTP IP test endpoint.
# Confirmed test entry; retain the actual existing IP/port during upgrades.
# IAM must approve that exact HTTP callback before employee acceptance.
# LIGHTHOUSE_DEPLOYMENT_ENV=test is supplied by the new compose. In existing
# compose, explicitly set it here as well.
NODE_ENV=production
LIGHTHOUSE_DEPLOYMENT_ENV=test
# Explicit IAM + middle-platform roles cutover after credentials/network are ready.
AUTH_MODE=iam
IAM_AUTHORIZATION_SOURCE=portal
LIGHTHOUSE_ORIGIN=http://10.0.147.68:16888
AUTH_TEST_HTTP_ORIGIN=http://10.0.147.68:16888
AUTH_ALLOW_LOCAL_HTTP=false
# IAM server calls always use HTTPS, even when the browser test entry is HTTP.
IAM_BASE_URL=https://sso.byd.com
IAM_CLIENT_ID=REPLACE_WITH_REGISTERED_IAM_CLIENT_ID
IAM_CLIENT_SECRET='REPLACE_WITH_PRIVATE_IAM_CLIENT_SECRET'
# Independent middle-platform role-query credentials, not IAM credentials.
PORTAL_API_BASE_URL=https://portal.example.invalid/api
# For a confirmed RFC1918 IPv4 HTTP API set its exact origin here, no slash/path.
PORTAL_API_HTTP_ORIGIN=
PORTAL_APP_CODE=REPLACE_WITH_REGISTERED_PORTAL_APP_CODE
PORTAL_APP_SECRET='REPLACE_WITH_PRIVATE_PORTAL_APP_SECRET'
# No IAM_SYNC_*, PORTAL_LOGIN_URL, employee assertion or role variables required.
# Fixed roles: lighthouse_user, lighthouse_knowledge_admin, lighthouse_admin.
AUTH_ENCRYPTION_KEY='REPLACE_WITH_DISTINCT_TEST_BASE64_32_BYTE_LOCAL_KEY'
# Keep this environment's existing AUTH_ENCRYPTION_KEY on upgrade. IAM keys differ
# from middle-platform secrets; do not copy keys between test and production.
# See docs/deployment/lighthouse-iam-portal.md; source=sync uses app.env.example.
HERMIT_RUNTIME=dsh
HERMIT_DSH_ROOT=
HERMIT_BUNDLE_REQUIRED=true
OPENAI_BASE_URL=REPLACE_WITH_INTERNAL_MODEL_ENDPOINT
OPENAI_MODEL=REPLACE_WITH_INTERNAL_MODEL_NAME
OPENAI_API_MODE=chat
OPENAI_API_KEY='REPLACE_WITH_PRIVATE_MODEL_KEY'
# Optional web invisible watermark. Enable after test tenant configuration/acceptance.
WATERMARK_ENABLE=false
WATERMARK_BASE_URL=
WATERMARK_API_KEY=
WATERMARK_SDK_URL=https://watermarktest.byd.com:8443/sdk/js-sdk.js
