# Private runtime file for the existing HTTP IP test endpoint.
# Replace this synthetic RFC1918 IP/port with the current unchanged test origin.
# LIGHTHOUSE_DEPLOYMENT_ENV=test is supplied by the new compose. In existing
# compose, explicitly set it here as well.
NODE_ENV=production
LIGHTHOUSE_DEPLOYMENT_ENV=test
AUTH_MODE=portal
LIGHTHOUSE_ORIGIN=http://10.20.30.40:18081
AUTH_TEST_HTTP_ORIGIN=http://10.20.30.40:18081
AUTH_ALLOW_LOCAL_HTTP=false
PORTAL_API_BASE_URL=https://portal.example/api
PORTAL_LOGIN_URL=https://portal.example/login
PORTAL_APP_CODE=REPLACE_WITH_TEST_PORTAL_APPLICATION
PORTAL_APP_SECRET='REPLACE_WITH_TEST_PORTAL_SECRET'
PORTAL_KNOWLEDGE_ADMIN_ROLE=REPLACE_WITH_EXACT_ROLE
AUTH_ENCRYPTION_KEY='REPLACE_WITH_DISTINCT_TEST_BASE64_32_BYTE_KEY'
PORTAL_EMPLOYEE_VALIDATION_CONFIRMED=false
PORTAL_CALLBACK_PARAM=redirectUrl
PORTAL_STATE_PARAM=state
PORTAL_TOKEN_PARAM=token
PORTAL_ALLOW_LEGACY_CONFIRMATION=false
HERMIT_RUNTIME=dsh
HERMIT_DSH_ROOT=
HERMIT_BUNDLE_REQUIRED=true
OPENAI_BASE_URL=REPLACE_WITH_INTERNAL_MODEL_ENDPOINT
OPENAI_MODEL=REPLACE_WITH_INTERNAL_MODEL_NAME
OPENAI_API_MODE=chat
OPENAI_API_KEY='REPLACE_WITH_PRIVATE_MODEL_KEY'
