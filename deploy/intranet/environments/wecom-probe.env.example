# Diagnostic-only private configuration. This does not enable Web login.
# Copy outside the repository; restrict it to the operator (0600 on Linux).
# Fill credentials locally. Never commit a populated copy or return it in logs.
WECOM_BASE_URL=https://wecom.example.invalid
WECOM_APP_ID=
WECOM_APP_KEY=

# Only needed for --verify-once. Obtain a fresh, unconsumed test ticket using
# the platform's approved callback/test process. Preserve employee ID zeros.
# A verification attempt may consume the ticket even when it times out.
WECOM_TEST_USER_ID=
WECOM_TEST_TOKEN=
