# Private IAM login + middle-platform role-query runtime configuration.
# Production employee template; guest environments use guest-app.env.example.
# Never include MYSQL_ROOT_PASSWORD or real credentials in a delivery/source package.
NODE_ENV=production
LIGHTHOUSE_DEPLOYMENT_ENV=production
AUTH_MODE=iam
IAM_AUTHORIZATION_SOURCE=portal
LIGHTHOUSE_ORIGIN=https://lighthouse.example.invalid
AUTH_TEST_HTTP_ORIGIN=
AUTH_ALLOW_LOCAL_HTTP=false
# IAM registration credentials. IAM server calls always require HTTPS origin.
IAM_BASE_URL=https://sso.byd.com
IAM_CLIENT_ID=REPLACE_WITH_REGISTERED_IAM_CLIENT_ID
IAM_CLIENT_SECRET='REPLACE_WITH_PRIVATE_IAM_CLIENT_SECRET'
# Separately registered middle-platform app credentials; never reuse IAM secret.
PORTAL_API_BASE_URL=https://portal.example.invalid/api
PORTAL_API_HTTP_ORIGIN=
PORTAL_APP_CODE=REPLACE_WITH_REGISTERED_PORTAL_APP_CODE
PORTAL_APP_SECRET='REPLACE_WITH_PRIVATE_PORTAL_APP_SECRET'
# Preserve this environment's existing stable local key during upgrade/source switch.
AUTH_ENCRYPTION_KEY='REPLACE_WITH_PRIVATE_BASE64_32_BYTE_LOCAL_KEY'
# No IAM_SYNC_*, PORTAL_LOGIN_URL, employee assertion or configurable role variables.
# Fixed roles: lighthouse_user, lighthouse_knowledge_admin, lighthouse_admin.
HERMIT_RUNTIME=dsh
HERMIT_DSH_ROOT=
HERMIT_BUNDLE_REQUIRED=true
OPENAI_BASE_URL=REPLACE_WITH_INTERNAL_MODEL_ENDPOINT
OPENAI_MODEL=REPLACE_WITH_INTERNAL_MODEL_NAME
OPENAI_API_MODE=chat
OPENAI_API_KEY='REPLACE_WITH_PRIVATE_MODEL_KEY'
# Database and knowledge-hub variables come from the existing compose control file.
# HTTP test example: test-app.env.example. Full guide: docs/deployment/lighthouse-iam-portal.md.
# Optional web invisible watermark. Production tenant/key must differ from test.
WATERMARK_ENABLE=false
WATERMARK_BASE_URL=
WATERMARK_API_KEY=
WATERMARK_SDK_URL=https://watermark.byd.com:8443/sdk/js-sdk.js
