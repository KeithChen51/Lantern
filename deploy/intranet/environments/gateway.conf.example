# Replace formal.example and lighthouse-production-app with reviewed environment values.
# Upstream LB/WAF terminates TLS; this server receives HTTP only from that gateway.
# Install into the existing gateway's include directory, then nginx -t before reload.
server {
    listen 80;
    server_name formal.example;
    client_max_body_size 64m;

    location / {
        # Docker DNS resolves a recreated app, rather than retaining its old IP.
        resolver 127.0.0.11 valid=10s;
        set $lighthouse_upstream lighthouse-production-app:3000;
        proxy_pass http://$lighthouse_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Dedicated production host: external origin is always HTTPS.
        # Configure real-IP trust at the shared gateway only for verified LB/WAF addresses.
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
# $connection_upgrade must already be defined in http{}, e.g.
# map $http_upgrade $connection_upgrade { default upgrade; '' close; }
