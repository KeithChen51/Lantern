{
  "name": "lantern-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build:knowledge": "tsx scripts/build-knowledge.ts",
    "prepare:standalone": "tsx scripts/prepare-standalone.ts",
    "build": "npm run build:knowledge && next build && npm run prepare:standalone",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:setup": "npm run db:deploy && npm run db:seed",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "hub": "tsx scripts/knowledge-hub.ts",
    "test:knowledge-standardize": "npm ci --prefix skills/lantern-knowledge-standardize --ignore-scripts && npm test --prefix skills/lantern-knowledge-standardize && node --import tsx --test skills/lantern-knowledge-standardize/tests/hub-compat.test.ts",
    "hub:mcp": "tsx scripts/knowledge-mcp.ts",
    "hub:import-existing": "tsx scripts/knowledge-import-existing.ts",
    "hub:bootstrap": "npm run db:deploy && npm run hub:import-existing -- --publish"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.47",
    "@ai-sdk/react": "^3.0.137",
    "@gsap/react": "^2.1.2",
    "@iconify/react": "^6.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^6.19.3",
    "ai": "^6.0.135",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "jszip": "3.10.2",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.13.0",
    "next": "16.1.1",
    "pdf-parse": "^2.4.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "esbuild": "0.27.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
