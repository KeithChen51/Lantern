DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/lighthouse"
# Railway preview: set DATABASE_URL to the MySQL service URL, e.g. ${{MySQL.MYSQL_URL}}
# Railway standalone server: force external binding because Railway sets HOSTNAME internally.
HOSTNAME="0.0.0.0"
# Direct IAM access. Inject application/sync credentials only after IAM registration.
# Production browser access requires HTTPS; both deployed modes use production builds.
# Explicit visitor access: AUTH_MODE=guest requires no IAM/PORTAL credentials.
# Keep AUTH_ENCRYPTION_KEY stable and set the same origin/MySQL requirements below.
# See docs/deployment/lighthouse-guest-mode.md for isolated guest/IAM deployment.
AUTH_MODE="iam"
# sync (default when omitted): IAM account/permission synchronization.
# portal: IAM login + independent middle-platform role-query; see
# docs/deployment/lighthouse-iam-portal.md and the dedicated deployment template.
IAM_AUTHORIZATION_SOURCE="sync"
LIGHTHOUSE_DEPLOYMENT_ENV="production"
LIGHTHOUSE_ORIGIN="https://lighthouse.example.com"
# Test-only exact canonical RFC1918 IPv4 HTTP origin; leave empty in production.
AUTH_TEST_HTTP_ORIGIN=""
AUTH_ALLOW_LOCAL_HTTP="false"
# Canonical HTTPS origin, without a slash/path/query. Never use the middle-platform key.
IAM_BASE_URL="https://sso.byd.com"
IAM_CLIENT_ID=""
IAM_CLIENT_SECRET=""
# Required only for IAM_AUTHORIZATION_SOURCE=sync.
# Incoming group permission platform sync: exact appKey + Base64 SPKI RSA public key.
IAM_SYNC_APP_KEY=""
IAM_SYNC_PUBLIC_KEY=""
# Dedicated Base64 AES-256 key (32 bytes) and CBC IV (16 bytes), agreed with IAM.
IAM_SYNC_AES_KEY=""
IAM_SYNC_AES_IV=""
# Distinct Base64 32-byte local credential-encryption key; stable across upgrades.
AUTH_ENCRYPTION_KEY=""
# IAM_AUTHORIZATION_SOURCE=portal needs these independent role-query credentials.
# Never reuse IAM_CLIENT_SECRET as PORTAL_APP_SECRET. No portal login URL,
# employee-validity assertion or configurable role mappings are needed in this mode.
# PORTAL_API_BASE_URL="https://portal.example.invalid/api"
# PORTAL_API_HTTP_ORIGIN=""
# PORTAL_APP_CODE=""
# PORTAL_APP_SECRET=""
# Explicit legacy rollback mode only: AUTH_MODE=portal requires its complete PORTAL_*
# configuration. IAM login never consumes portal tokens; only source=portal queries roles.
# See docs/deployment/lighthouse-iam-direct.md before switching a running deployment.
# Shared admin passwords and preview identities are retired login mechanisms.
# Games preview is visible by default. Set false at build time to hide it.
NEXT_PUBLIC_SHOW_GAMES="true"
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL="qwen3.6-plus"
# chat = OpenAI-compatible Chat Completions; responses = OpenAI Responses API.
OPENAI_API_MODE="chat"
# Optional JSON object for non-standard internal gateway auth headers.
# Example: {"X-Api-Key":"TOKEN"} or {"Authorization":"Bearer TOKEN"}
OPENAI_EXTRA_HEADERS=""
# Server-only Gitee-compatible BYD DevOps Issue integration.
BYD_DEVOPS_ISSUES_API_URL=""
BYD_DEVOPS_AUTH_MODE="authorization-token"
BYD_DEVOPS_TOKEN=""
# Knowledge is read progressively from the indexed knowledge hub. No
# embedding model or vector cache is required for the build or runtime.

# Apply MySQL migrations before launch. Initialize knowledge only in a new empty
# environment; existing test upgrades never initialize, seed or import knowledge.
KNOWLEDGE_HUB_ENABLED="true"

# Deployed application (guest or employee) requires mysql. SQLite is standalone maintenance only
# (Node.js >= 22.13); never switch a production app to SQLite as a DB fallback.
KNOWLEDGE_HUB_DRIVER="mysql"
KNOWLEDGE_HUB_SQLITE_PATH="storage/knowledge/lighthouse.sqlite"

# Hermit DSH runtime requires the populated knowledge hub and matching carrier.
HERMIT_RUNTIME="dsh"
# Optional development override. Empty uses deployment-local runtime/hermit-dsh (Node 24).
HERMIT_DSH_ROOT=""

# Deployment builds fail if the bundled runtime is absent when this is true.
HERMIT_BUNDLE_REQUIRED=false
