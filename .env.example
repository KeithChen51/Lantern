DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/lighthouse"
# Railway preview: set DATABASE_URL to the MySQL service URL, e.g. ${{MySQL.MYSQL_URL}}
# Railway standalone server: force external binding because Railway sets HOSTNAME internally.
HOSTNAME="0.0.0.0"
# Employee access; populate only after the portal contract has been verified.
# Production deployment requires HTTPS. Both production/test builds need MySQL.
AUTH_MODE="portal"
LIGHTHOUSE_DEPLOYMENT_ENV="production"
LIGHTHOUSE_ORIGIN="https://lighthouse.example.com"
# Explicit test-only exception: canonical RFC1918 IPv4 HTTP origin, exactly
# equal to LIGHTHOUSE_ORIGIN; requires LIGHTHOUSE_DEPLOYMENT_ENV=test.
# Leave empty in production. Does not allow HTTP portal API/login endpoints.
AUTH_TEST_HTTP_ORIGIN=""
PORTAL_API_BASE_URL="https://portal.example.com/api"
# Optional exact canonical RFC1918 HTTP API origin, matching PORTAL_API_BASE_URL.origin.
# Example: http://10.20.30.40:20002. Valid in production/test; no TLS bypass.
PORTAL_API_HTTP_ORIGIN=""
PORTAL_LOGIN_URL="https://portal.example.com/login"
# card: open the fixed portal URL; the portal app card returns a token.
# callback: use redirectUrl/state only after that contract is confirmed.
# The code default remains callback for existing deployments; choose explicitly.
PORTAL_LOGIN_MODE="card"
PORTAL_APP_CODE=""
PORTAL_APP_SECRET=""
PORTAL_KNOWLEDGE_ADMIN_ROLE=""
# Optional exact upstream platform-admin role; grants existing knowledge:manage.
# Confirm the role identifier and semantics with the portal; never infer a name.
PORTAL_PLATFORM_ADMIN_ROLE=""
# A dedicated base64-encoded 32-byte key. Inject secrets at runtime, never commit.
AUTH_ENCRYPTION_KEY=""
# Set true only after confirming active internal employee validation semantics.
PORTAL_EMPLOYEE_VALIDATION_CONFIRMED="false"
# Callback/state apply to callback mode; token also applies to card entry.
PORTAL_CALLBACK_PARAM="redirectUrl"
PORTAL_STATE_PARAM="state"
PORTAL_TOKEN_PARAM="token"
PORTAL_ALLOW_LEGACY_CONFIRMATION="false"
# Only NODE_ENV!=production + deployment=development loopback may enable this.
# Deployed HTTP tests use AUTH_TEST_HTTP_ORIGIN, never this development flag.
AUTH_ALLOW_LOCAL_HTTP="false"
# Shared admin passwords and preview identities are retired login mechanisms.
# Games preview is visible by default. Set false at build time to hide it.
NEXT_PUBLIC_SHOW_GAMES="true"
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL="qwen3.6-plus"
# chat = OpenAI-compatible Chat Completions; responses = OpenAI Responses API.
OPENAI_API_MODE="chat"
# Optional JSON object for non-standard internal gateway auth headers.
# Example: {"X-Api-Key":"TOKEN"} or {"Authorization":"Bearer TOKEN"}
OPENAI_EXTRA_HEADERS=""
# Server-only Gitee-compatible BYD DevOps Issue integration.
BYD_DEVOPS_ISSUES_API_URL=""
BYD_DEVOPS_AUTH_MODE="authorization-token"
BYD_DEVOPS_TOKEN=""
# Knowledge is read progressively from the indexed knowledge hub. No
# embedding model or vector cache is required for the build or runtime.

# Apply MySQL migrations before launch. Initialize knowledge only in a new empty
# environment; existing test upgrades never initialize, seed or import knowledge.
KNOWLEDGE_HUB_ENABLED="true"

# Employee application requires mysql. SQLite is standalone maintenance only
# (Node.js >= 22.13); never switch a production app to SQLite as a DB fallback.
KNOWLEDGE_HUB_DRIVER="mysql"
KNOWLEDGE_HUB_SQLITE_PATH="storage/knowledge/lighthouse.sqlite"

# Hermit DSH runtime requires the populated knowledge hub and matching carrier.
HERMIT_RUNTIME="dsh"
# Optional development override. Empty uses deployment-local runtime/hermit-dsh (Node 24).
HERMIT_DSH_ROOT=""

# Deployment builds fail if the bundled runtime is absent when this is true.
HERMIT_BUNDLE_REQUIRED=false
