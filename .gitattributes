# License bytes are verified against upstream SHA-256 values.
scripts/hermit-runtime/licenses/*.txt -text

# Offline inputs have byte-exact SHA-256 checks; never convert their line endings.
deploy/offline/** -text

# Shell entry points must remain executable by Linux bash after Windows checkout.
*.sh text eol=lf

# Bundled fonts and license text are checked against byte-exact hashes.
public/fonts/** -text
# Preserve upstream license bytes, including upstream trailing spaces.
public/fonts/**/LICENSE.txt whitespace=-blank-at-eol

# Preserve imported bundles, source metadata and original license notices byte for byte.
docs/design/visualizations/runtime/** -text -diff
docs/design/visualizations/maps/*.js -text -diff
docs/design/visualizations/maps/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
docs/design/visualizations/licenses/** -text whitespace=-blank-at-eol,-blank-at-eof
docs/design/visualizations/source/** -text
